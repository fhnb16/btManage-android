<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme shown until Compose draws its first frame. -->
    <style name="Theme.BtManage" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- The panel a tap on the widget opens: a window that lets the home screen show through.
         The panel draws its own shade and its own motion (PopupActivity), so the window has
         neither: no dimming, no opening or closing animation. -->
    <style name="Theme.BtManage.Popup">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <color name="launcher_background">#0082FC</color>
</resources>
